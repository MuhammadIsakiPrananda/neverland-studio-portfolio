# ===========================================
# BACKEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and configure
# Run: php artisan key:generate to generate APP_KEY
# ===========================================

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME="Neverland Studio Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ===========================================
# MAINTENANCE MODE
# ===========================================
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neverland_portfolio
DB_USERNAME=root
DB_PASSWORD=
# DB_SOCKET=  # Optional: Unix socket connection

# Alternative: Use full DATABASE_URL
# DATABASE_URL=mysql://user:password@localhost:3306/database

# ===========================================
# QUEUE CONFIGURATION
# ===========================================
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=sync  # Use for testing without queue
# QUEUE_CONNECTION=redis  # Use for production

# Database Queue Settings
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# Redis Queue Settings (if using redis)
# REDIS_QUEUE_HOST=127.0.0.1
# REDIS_QUEUE_PASSWORD=null
# REDIS_QUEUE_PORT=6379
# REDIS_QUEUE_DATABASE=0

# ===========================================
# CACHE CONFIGURATION
# ===========================================
CACHE_STORE=file
# CACHE_STORE=redis  # Recommended for production
CACHE_PREFIX=

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_DRIVER=database
# SESSION_DRIVER=redis  # Recommended for production
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ===========================================
# BROADCASTING
# ===========================================
BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=pusher
# BROADCAST_CONNECTION=redis

# Pusher Settings (if using pusher)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_HOST=
# PUSHER_PORT=443
# PUSHER_SCHEME=https
# PUSHER_APP_CLUSTER=mt1

# ===========================================
# FILESYSTEM / STORAGE
# ===========================================
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=s3  # For cloud storage

# AWS S3 Configuration (if using s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# MAIL CONFIGURATION
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Alternative Mail Drivers:
# MAIL_MAILER=log  # For testing (logs to file)
# MAIL_MAILER=array  # For testing (stores in memory)

# Mailgun (if using mailgun)
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net

# Postmark (if using postmark)
# POSTMARK_API_KEY=

# Resend (if using resend)
# RESEND_API_KEY=

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
FRONTEND_URL=http://localhost:5173

# ===========================================
# SANCTUM / API AUTHENTICATION
# ===========================================
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost
SESSION_DOMAIN=

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CORS_ALLOWED_METHODS="GET,POST,PUT,DELETE,OPTIONS,PATCH"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-Requested-With,X-XSRF-TOKEN"
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=0
CORS_SUPPORTS_CREDENTIALS=true

# ===========================================
# OAUTH CONFIGURATION
# ===========================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8000/api/auth/github/callback

# ===========================================
# RATE LIMITING
# ===========================================
# Uncomment to customize rate limits
# THROTTLE_LOGIN=5,1  # 5 attempts per minute
# THROTTLE_API=60,1   # 60 requests per minute

# ===========================================
# SECURITY
# ===========================================
# Password Reset Token Lifetime (minutes)
PASSWORD_RESET_TOKEN_LIFETIME=60

# Email Verification Token Lifetime (minutes)
EMAIL_VERIFICATION_TOKEN_LIFETIME=60

# ===========================================
# THIRD PARTY SERVICES
# ===========================================

# Slack Notifications (optional)
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# ===========================================
# DEVELOPMENT / DEBUGGING
# ===========================================
# Laravel Telescope (if installed)
# TELESCOPE_ENABLED=true

# Laravel Debugbar (if installed)
# DEBUGBAR_ENABLED=true

# Query Logging
# LOG_QUERY=false
# LOG_QUERY_SLOW_TIME=100  # milliseconds

# ===========================================
# VITE BUILD TOOL
# ===========================================
VITE_APP_NAME="${APP_NAME}"
