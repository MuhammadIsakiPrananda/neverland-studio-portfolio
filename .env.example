# ===========================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and configure for your environment
# For production: set VITE_APP_ENV=production
# For development: set VITE_APP_ENV=development
# ===========================================

# ===========================================
# APPLICATION SETTINGS
# ===========================================
VITE_APP_NAME=Neverland Studio Portfolio
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Portfolio and consultation platform for Neverland Studio"

# ===========================================
# API CONFIGURATION
# ===========================================
# Development: use localhost with port
# Production: use your domain or relative path /api

# Local Development
VITE_API_URL=http://localhost:8000/api

# Production Options (uncomment one)
# VITE_API_URL=/api  # Relative path (when frontend and backend share domain)
# VITE_API_URL=https://api.neverlandstudio.my.id  # Separate API domain
# VITE_API_URL=https://portfolio.neverlandstudio.my.id/api  # Same domain with /api path

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ===========================================
# AUTHENTICATION
# ===========================================
# Token storage key
VITE_AUTH_TOKEN_KEY=auth_token
VITE_AUTH_USER_KEY=auth_user

# Session timeout (minutes)
VITE_SESSION_TIMEOUT=120

# Remember me duration (days)
VITE_REMEMBER_ME_DAYS=30

# ===========================================
# OAUTH PROVIDERS
# ===========================================
# Enable/disable OAuth providers
VITE_ENABLE_GOOGLE_AUTH=true
VITE_ENABLE_GITHUB_AUTH=true

# OAuth redirect URLs (should match backend configuration)
VITE_GOOGLE_REDIRECT_URL=http://localhost:8000/api/auth/google/callback
VITE_GITHUB_REDIRECT_URL=http://localhost:8000/api/auth/github/callback

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable/disable features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true

# Dashboard Features
VITE_ENABLE_DASHBOARD_ANALYTICS=true
VITE_ENABLE_ACTIVITY_LOG=true
VITE_ENABLE_CONSULTATION_BOOKING=true
VITE_ENABLE_PHOTO_UPLOAD=true
VITE_ENABLE_PROFILE_MANAGEMENT=true

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
# Google Analytics
VITE_GA_TRACKING_ID=
VITE_GA_DEBUG=false

# Google Tag Manager (optional)
# VITE_GTM_ID=GTM-XXXXXXX

# Facebook Pixel (optional)
# VITE_FB_PIXEL_ID=

# Sentry Error Tracking (optional)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# PERFORMANCE
# ===========================================
# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITOR=true

# Performance thresholds (milliseconds)
VITE_PERFORMANCE_WARN_THRESHOLD=1000
VITE_PERFORMANCE_ERROR_THRESHOLD=3000

# Image optimization
VITE_IMAGE_MAX_SIZE=5242880  # 5MB in bytes
VITE_IMAGE_QUALITY=0.8
VITE_IMAGE_MAX_WIDTH=1920
VITE_IMAGE_MAX_HEIGHT=1080

# ===========================================
# REALTIME / WEBSOCKETS
# ===========================================
# Polling interval for realtime updates (milliseconds)
VITE_REALTIME_POLL_INTERVAL=30000

# WebSocket configuration (if using)
# VITE_WS_HOST=localhost
# VITE_WS_PORT=6001
# VITE_WS_KEY=
# VITE_WS_CLUSTER=mt1
# VITE_WS_FORCE_TLS=false

# ===========================================
# UI/UX CONFIGURATION
# ===========================================
# Default language
VITE_DEFAULT_LANGUAGE=en
VITE_AVAILABLE_LANGUAGES=en,id

# Default theme
VITE_DEFAULT_THEME=light
# VITE_DEFAULT_THEME=dark

# Animation settings
VITE_ENABLE_ANIMATIONS=true
VITE_ANIMATION_DURATION=300

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# ===========================================
# SEO CONFIGURATION
# ===========================================
VITE_SEO_TITLE=Neverland Studio Portfolio
VITE_SEO_DESCRIPTION="Professional portfolio and consultation platform"
VITE_SEO_KEYWORDS="portfolio,web development,consultation,neverland studio"
VITE_SEO_AUTHOR=Neverland Studio
VITE_SEO_IMAGE=/og-image.jpg

# Social Media
VITE_SOCIAL_TWITTER=@neverlandstudio
VITE_SOCIAL_FACEBOOK=neverlandstudio
VITE_SOCIAL_INSTAGRAM=neverlandstudio
VITE_SOCIAL_LINKEDIN=neverland-studio

# ===========================================
# CONTACT INFORMATION
# ===========================================
VITE_CONTACT_EMAIL=hello@neverlandstudio.my.id
VITE_CONTACT_PHONE=+62-XXX-XXXX-XXXX
VITE_CONTACT_ADDRESS="Your Address Here"

# ===========================================
# MAPS & LOCATION (optional)
# ===========================================
# Google Maps API Key (if using maps)
# VITE_GOOGLE_MAPS_API_KEY=

# Default location coordinates
# VITE_DEFAULT_LAT=-6.200000
# VITE_DEFAULT_LNG=106.816666

# ===========================================
# PAYMENT GATEWAY (optional)
# ===========================================
# Stripe (if implementing payments)
# VITE_STRIPE_PUBLIC_KEY=

# Midtrans (if using Indonesian payment)
# VITE_MIDTRANS_CLIENT_KEY=
# VITE_MIDTRANS_ENVIRONMENT=sandbox  # or production

# ===========================================
# CLOUDFLARE
# ===========================================
# Cloudflare Tunnel (for deployment)
# Get your tunnel token from: https://one.dash.cloudflare.com/
# Access → Tunnels → Create Tunnel → Copy token
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Turnstile (CAPTCHA alternative)
# VITE_CF_TURNSTILE_SITE_KEY=

# ===========================================
# CDN & ASSETS
# ===========================================
# CDN URL for static assets (if using CDN)
# VITE_CDN_URL=https://cdn.neverlandstudio.my.id

# Asset versioning for cache busting
VITE_ASSET_VERSION=1.0.0

# ===========================================
# BUILD CONFIGURATION
# ===========================================
NODE_ENV=development
# NODE_ENV=production  # Uncomment for production builds

# Build output directory
# VITE_BUILD_DIR=dist

# Source maps in production
VITE_GENERATE_SOURCEMAP=false

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================
# Enable React DevTools in production
VITE_ENABLE_REACT_DEVTOOLS=false

# Enable Console logs in production
VITE_ENABLE_CONSOLE_LOGS=false

# Hot Module Replacement (HMR) port
VITE_HMR_PORT=5173

# ===========================================
# SECURITY
# ===========================================
# Content Security Policy
# VITE_CSP_REPORT_URI=

# Enable HTTPS in development
VITE_HTTPS=false

# ===========================================
# THIRD PARTY INTEGRATIONS
# ===========================================
# Crisp Chat (if using live chat)
# VITE_CRISP_WEBSITE_ID=

# Intercom (if using customer messaging)
# VITE_INTERCOM_APP_ID=

# Google reCAPTCHA (if using captcha)
# VITE_RECAPTCHA_SITE_KEY=

# ===========================================
# LOGGING
# ===========================================
# Log level: debug, info, warn, error
VITE_LOG_LEVEL=debug

# Log to console
VITE_LOG_TO_CONSOLE=true

# Log to remote service (if configured)
# VITE_LOG_REMOTE_URL=

